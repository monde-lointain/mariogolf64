#!/usr/bin/env bash
# sync-shard: rebase this worktree's branch onto $MG64_SYNC_BRANCH (no-op when unset).
#
# The decompile tasks run it first in candidate_source, when nigel has a clean
# tree between candidates. Commits already integrated into the sync branch drop
# out, and the shard picks up fixes merged from other shards, so shards stop
# diverging (for example two shards declaring the same global with different
# types).
#
# A commit the integrator picked with a hand-resolved conflict no longer matches
# its original, so a plain rebase conflicts on it. On a conflict the rebase is
# retried preferring the sync branch's side of each conflicting hunk (-X ours;
# in a rebase "ours" is the upstream), which turns an already-integrated commit
# into an empty one that is dropped. That result is kept only if every line the
# shard added since its merge base is still present (nothing of the shard's own
# work was dropped) and ./tools/build-and-verify.sh passes. Otherwise the branch
# is restored and the shard keeps running unsynced. This never fails the
# candidate source.
set -u
[[ -n ${MG64_SYNC_BRANCH:-} ]] || exit 0
before=$(git rev-parse HEAD)
base=$(git merge-base "$MG64_SYNC_BRANCH" HEAD)
git rebase -q "$MG64_SYNC_BRANCH" >/dev/null 2>&1 && exit 0
git rebase --abort >/dev/null 2>&1

# Every non-blank line the shard added must survive the retried rebase.
kept_shard_lines() {
    local path="" line
    while IFS= read -r line; do
        case "$line" in
            '+++ b/'*) path=${line#+++ b/} ;;
            '+++ '*) path="" ;;
            '+'*)
                line=${line#+}
                [[ -z $path || -z ${line//[[:space:]]/} ]] && continue
                grep -Fxq -- "$line" "$path" 2>/dev/null || return 1
                ;;
        esac
    done < <(git diff -U0 "$base" "$before")
}

if git rebase -q -X ours "$MG64_SYNC_BRANCH" >/dev/null 2>&1 && kept_shard_lines &&
    ./tools/build-and-verify.sh >/dev/null 2>&1; then
    echo "sync-shard: rebased onto $MG64_SYNC_BRANCH preferring its side of conflicts" >&2
    exit 0
fi
git rebase --abort >/dev/null 2>&1
git reset -q --hard "$before"
echo "sync-shard: rebase onto $MG64_SYNC_BRANCH conflicted; continuing unsynced" >&2
exit 0
