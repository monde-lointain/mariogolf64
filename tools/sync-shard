#!/usr/bin/env bash
# sync-shard: rebase this worktree's branch onto $MG64_SYNC_BRANCH (no-op when unset).
#
# The decompile tasks run it first in candidate_source, when nigel has a clean
# tree between candidates. Commits already integrated into the sync branch drop
# out, and the shard picks up fixes merged from other shards, so shards stop
# diverging (for example two shards declaring the same global with different
# types).
#
# Conflicts in src/**/*.c go through tools/merge-decomp-c (see .gitattributes),
# which resolves the usual ones between neighbouring matches. A commit the
# integrator picked with a hand-resolved conflict no longer matches its
# original, so the rebase can still conflict on it. Then it is retried
# preferring the sync branch's side of each conflicting hunk (-X ours and
# MG64_MERGE_FAVOR=ours; in a rebase "ours" is the upstream), which turns an
# already-integrated commit into an empty one that is dropped. That result is
# kept only if nothing of the shard's own work was dropped:
#   - in src/ and include/, every function the shard decompiled (each
#     INCLUDE_ASM line it removed) is still decompiled. Declarations may differ,
#     because the integrator may have merged them with another shard's;
#   - elsewhere (harness, docs), every non-blank line the shard added is present.
# Any rebase that moves HEAD must also pass ./tools/build-and-verify.sh.
# Otherwise the branch is restored and the shard keeps running unsynced. This
# never fails the candidate source.
#
# It runs only when nigel selects a candidate. After the agent finishes, nigel
# re-runs the candidate source with NIGEL_CANDIDATE set to judge the result; a
# moved HEAD there would read as an agent commit, so that run skips the sync.
set -u
[[ -n ${MG64_SYNC_BRANCH:-} && -z ${NIGEL_CANDIDATE:-} ]] || exit 0
before=$(git rev-parse HEAD)
base=$(git merge-base "$MG64_SYNC_BRANCH" HEAD)
synced() { [[ $(git rev-parse HEAD) == "$before" ]] || ./tools/build-and-verify.sh >/dev/null 2>&1; }
if git rebase -q "$MG64_SYNC_BRANCH" >/dev/null 2>&1; then
    synced && exit 0
    git reset -q --hard "$before"
    echo "sync-shard: rebase onto $MG64_SYNC_BRANCH does not build; continuing unsynced" >&2
    exit 0
fi
git rebase --abort >/dev/null 2>&1

kept_shard_work() {
    local path="" line fn
    while IFS= read -r line; do
        case "$line" in
            '+++ b/'*) path=${line#+++ b/} ;;
            '+++ '*) path="" ;;
            '-'*INCLUDE_ASM\(*)
                # A match: the function must not be INCLUDE_ASM anywhere after the sync.
                fn=${line##*, }; fn=${fn%%)*}
                ! grep -rqF -- ", $fn);" src 2>/dev/null || return 1
                ;;
            '+'*)
                line=${line#+}
                [[ -z $path || -z ${line//[[:space:]]/} ]] && continue
                [[ $path == src/* || $path == include/* ]] && continue
                grep -Fxq -- "$line" "$path" 2>/dev/null || return 1
                ;;
        esac
    done < <(git diff -U0 "$base" "$before")
}

if MG64_MERGE_FAVOR=ours git rebase -q -X ours "$MG64_SYNC_BRANCH" >/dev/null 2>&1 && kept_shard_work && synced; then
    echo "sync-shard: rebased onto $MG64_SYNC_BRANCH preferring its side of conflicts" >&2
    exit 0
fi
git rebase --abort >/dev/null 2>&1
git reset -q --hard "$before"
echo "sync-shard: rebase onto $MG64_SYNC_BRANCH conflicted; continuing unsynced" >&2
exit 0
