compiler_type = "gcc"
compiler_command = @COMPILER_COMMAND@
assembler_command = "bash tools/modern_as.sh -march=vr4300 -32 -EB -I include --no-pad-sections"
objdump_command = "bash tools/modern_objdump.sh -drz -m mips:4300"
asm_prelude_file = "tools/kmc_main_prelude.inc"

[decompme]
flags = @DECOMPME_FLAGS@

[decompme.compilers]
@COMPILER_KEY@ = "gcc2.7.2kmc"
