+/* The oracle's merging (see tools/oracle.py): ORACLE_MERGE names, as
+   KEPT=GONE pairs joined by commas, pseudos to make one in INSNS, the RTL
+   of the function ORACLE_FUNCTION as it is first made, before any pass
+   sees it: each use of GONE becomes one of KEPT, as though the source had
+   held both values in one variable.  A pair whose modes differ is left
+   alone.  */
+
+static void
+oracle_merge_pseudos (insns)
+     rtx insns;
+{
+  char *function = getenv ("ORACLE_FUNCTION");
+  char *pairs = getenv ("ORACLE_MERGE");
+  int kept, gone, length;
+  rtx insn, pattern;
+
+  if (function == 0 || pairs == 0 || *pairs == 0
+      || strcmp (function, current_function_name) != 0)
+    return;
+  while (sscanf (pairs, "%d=%d%n", &kept, &gone, &length) == 2)
+    {
+      if (kept >= FIRST_PSEUDO_REGISTER && gone >= FIRST_PSEUDO_REGISTER
+	  && kept < max_reg_num () && gone < max_reg_num () && kept != gone
+	  && regno_reg_rtx[kept] != 0 && regno_reg_rtx[gone] != 0
+	  && (GET_MODE (regno_reg_rtx[kept])
+	      == GET_MODE (regno_reg_rtx[gone])))
+	for (insn = insns; insn; insn = NEXT_INSN (insn))
+	  if (GET_RTX_CLASS (GET_CODE (insn)) == 'i')
+	    {
+	      oracle_replace_pseudo (&PATTERN (insn), gone,
+				     regno_reg_rtx[kept]);
+	      oracle_replace_pseudo (&REG_NOTES (insn), gone,
+				     regno_reg_rtx[kept]);
+	      if (GET_CODE (insn) == CALL_INSN)
+		oracle_replace_pseudo (&CALL_INSN_FUNCTION_USAGE (insn), gone,
+				       regno_reg_rtx[kept]);
+	    }
+      pairs += length;
+      if (*pairs != ',')
+	break;
+      pairs++;
+    }
+}
