+static char *oracle_separator;
+
+/* Write to FILE each variable in the chain DECLS held in a pseudo.  */
+
+static void
+oracle_trace_decls (file, decls)
+     FILE *file;
+     tree decls;
+{
+  tree decl;
+
+  for (decl = decls; decl; decl = TREE_CHAIN (decl))
+    if (DECL_NAME (decl) != 0 && DECL_RTL (decl) != 0
+	&& GET_CODE (DECL_RTL (decl)) == REG
+	&& REGNO (DECL_RTL (decl)) >= FIRST_PSEUDO_REGISTER)
+      {
+	fputs (oracle_separator, file);
+	fputs ("{\"name\": \"", file);
+	fputs (IDENTIFIER_POINTER (DECL_NAME (decl)), file);
+	oracle_put_item (file, "\", \"pseudo\": ", REGNO (DECL_RTL (decl)));
+	oracle_put_item (file, ", \"line\": ", DECL_SOURCE_LINE (decl));
+	fputs ("}", file);
+	oracle_separator = ", ";
+      }
+}
+
+/* Write to FILE the variables of BLOCK and of the blocks in it.  */
+
+static void
+oracle_trace_block_decls (file, block)
+     FILE *file;
+     tree block;
+{
+  tree inner;
+
+  oracle_trace_decls (file, BLOCK_VARS (block));
+  for (inner = BLOCK_SUBBLOCKS (block); inner; inner = BLOCK_CHAIN (inner))
+    oracle_trace_block_decls (file, inner);
+}
+
+/* Write to the trace the variables of the function DECL, and the modes
+   of its pseudos.  */
+
+static void
+oracle_trace_variables (decl)
+     tree decl;
+{
+  FILE *file = oracle_open_trace ();
+  int regno;
+
+  if (file == 0)
+    return;
+  fputs ("{\"stage\": \"variables\", \"variables\": [", file);
+  oracle_separator = "";
+  oracle_trace_decls (file, DECL_ARGUMENTS (decl));
+  if (DECL_INITIAL (decl) != 0 && TREE_CODE (DECL_INITIAL (decl)) == BLOCK)
+    oracle_trace_block_decls (file, DECL_INITIAL (decl));
+  fputs ("], \"pseudos\": {", file);
+  for (regno = FIRST_PSEUDO_REGISTER; regno < max_reg_num (); regno++)
