+/* Return the class rank_for_schedule gives INSN after the last insn
+   scheduled: 1 if it depends on the last's data, 2 on its other uses, and
+   3 if on neither, or it takes one cycle.  */
+
+static int
+oracle_schedule_class (insn)
+     rtx insn;
+{
+  rtx link = find_insn_list (insn, LOG_LINKS (last_scheduled_insn));
+
+  if (link == 0 || insn_cost (insn, link, last_scheduled_insn) == 1)
+    return 3;
+  if (REG_NOTE_KIND (link) == 0)
+    return 1;
+  return 2;
+}
+
+/* Number the choice of the next insn to schedule, the first of the N_READY
+   in READY, as a decision, and take the second instead where the oracle
+   flips it.  The trace records the two insns, why the first comes first,
+   by "launch", "priority", "class" or "order" (the insns' order in the
+   RTL), and which pass, "sched" before reload or "sched2" after, chose.  */
+
+static void
+oracle_decide_schedule (ready, n_ready)
+     rtx *ready;
+     int n_ready;
+{
+  int index;
+  FILE *file;
+  rtx first, second;
+  char *by = "order";
+
+  if (n_ready < 2 || (index = oracle_next_decision ()) < 0)
+    return;
+  first = ready[0];
+  second = ready[1];
+  if ((file = oracle_open_trace ()) != 0)
+    {
+      /* An insn whose register is born is launched, by its priority's
+	 rising to LAUNCH_PRIORITY's range (see adjust_priority), and the
+	 gap between such a priority and another is no distance */
+      if (LOW_PRIORITY_P (first) != LOW_PRIORITY_P (second))
+	by = "launch";
+      else if (INSN_PRIORITY (first) != INSN_PRIORITY (second))
+	by = "priority";
+      else if (last_scheduled_insn != 0
+	       && (oracle_schedule_class (first)
+		   != oracle_schedule_class (second)))
+	by = "class";
+      oracle_put_item (file, "{\"stage\": \"decision\", \"index\": ", index);
+      fputs (reload_completed
+	     ? ", \"site\": \"sched2\"" : ", \"site\": \"sched\"", file);
+      oracle_put_item (file, ", \"insns\": [", INSN_UID (first));
+      oracle_put_item (file, ", ", INSN_UID (second));
+      oracle_put_item (file, "], \"gap\": ",
+		       INSN_PRIORITY (first) - INSN_PRIORITY (second));
+      fputs (", \"by\": \"", file);
+      fputs (by, file);
+      fputs ("\"}\n", file);
+      oracle_end_record (file);
+    }
+  if (oracle_flips_decision (index))
+    {
+      ready[0] = second;
+      ready[1] = first;
+    }
+}
