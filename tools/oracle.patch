+	fputs (GET_MODE_NAME (GET_MODE (regno_reg_rtx[regno])), file);
+	oracle_put_item (file, "\", ", REG_USERVAR_P (regno_reg_rtx[regno]) != 0);
+	fputs ("]", file);
+      }
+  fputs ("}}\n", file);
+  oracle_end_record (file);
