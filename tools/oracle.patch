+/* Write to FILE, as a JSON list, the hard registers in SET.  */
+
+static void
+oracle_print_hard_regs (file, set)
+     FILE *file;
+     HARD_REG_SET set;
+{
+  int regno;
+  char *separator = "";
+
+  fprintf (file, "[");
+  for (regno = 0; regno < FIRST_PSEUDO_REGISTER; regno++)
+    if (TEST_HARD_REG_BIT (set, regno))
+      {
+	fprintf (file, "%s%d", separator, regno);
+	separator = ", ";
+      }
+  fprintf (file, "]");
+}
+
+/* Record for the oracle's trace (see oracle_open_trace in reload1.c) each
+   allocno, in the order they were placed in.  */
+
+static void
+oracle_trace_global ()
+{
+  FILE *file;
+  int i, allocno, other;
+  char *separator;
+
+  if (max_allocno == 0 || (file = oracle_open_trace ()) == 0)
+    return;
+  fprintf (file, "{\"stage\": \"global\", \"allocnos\": [");
+  for (i = 0; i < max_allocno; i++)
+    {
+      allocno = allocno_order[i];
+      fprintf (file, "%s{\"pseudo\": %d, \"n_refs\": %d, \"size\": %d, "
+	       "\"live_length\": %d, \"calls_crossed\": %d, "
+	       "\"hard\": %d, \"conflicts\": [",
+	       i == 0 ? "" : ", ", allocno_reg[allocno],
+	       allocno_n_refs[allocno], allocno_size[allocno],
+	       allocno_live_length[allocno], allocno_calls_crossed[allocno],
+	       reg_renumber[allocno_reg[allocno]]);
+      separator = "";
+      for (other = 0; other < max_allocno; other++)
+	if (other != allocno && CONFLICTP (allocno, other))
+	  {
+	    fprintf (file, "%s%d", separator, allocno_reg[other]);
+	    separator = ", ";
+	  }
+      fprintf (file, "], \"hard_conflicts\": ");
+      oracle_print_hard_regs (file, hard_reg_conflicts[allocno]);
+      fprintf (file, ", \"preferences\": ");
+      oracle_print_hard_regs (file, hard_reg_preferences[allocno]);
+      fprintf (file, ", \"copy_preferences\": ");
+      oracle_print_hard_regs (file, hard_reg_copy_preferences[allocno]);
+      fprintf (file, "}");
+    }
+  fprintf (file, "]}\n");
+  fclose (file);
+}
