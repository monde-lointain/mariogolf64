+/* Write to FILE, as a JSON list, the hard registers in SET.  */
+
+static void
+oracle_print_hard_regs (file, set)
+     FILE *file;
+     HARD_REG_SET set;
+{
+  int regno;
+  char *separator = "";
+
+  fputs ("[", file);
+  for (regno = 0; regno < FIRST_PSEUDO_REGISTER; regno++)
+    if (TEST_HARD_REG_BIT (set, regno))
+      {
+	oracle_put_item (file, separator, regno);
+	separator = ", ";
+      }
+  fputs ("]", file);
+}
+
+/* Write to FILE, after SEPARATOR, the start of a JSON object for ALLOCNO,
+   with the figures it is placed by.  */
+
+static void
+oracle_print_allocno (file, separator, allocno)
+     FILE *file;
+     char *separator;
+     int allocno;
+{
+  fputs (separator, file);
+  oracle_put_item (file, "{\"pseudo\": ", allocno_reg[allocno]);
+  oracle_put_item (file, ", \"n_refs\": ", allocno_n_refs[allocno]);
+  oracle_put_item (file, ", \"size\": ", allocno_size[allocno]);
+  oracle_put_item (file, ", \"live_length\": ", allocno_live_length[allocno]);
+  oracle_put_item (file, ", \"calls_crossed\": ",
