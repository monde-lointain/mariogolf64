+/* Record for the oracle's trace, as global-alloc starts, what it places
+   the allocnos from, so that a tool can replay the placing (see
+   prune_preferences and find_reg) in another order: the register sets of
+   the machine, which hard registers' classes find_reg counts as alike,
+   the hard registers in use so far and those local-alloc gave pseudos,
+   and each allocno's figures, classes, preferences before they are
+   pruned, and the allocnos in its row of the conflict matrix, which
+   needn't be in theirs.  */
+
+static void
+oracle_trace_global_start ()
+{
+  FILE *file;
+  int i, j, allocno;
+  char *separator;
+  enum reg_class class;
+  enum machine_mode mode;
+  HARD_REG_SET set;
+
+  if (max_allocno == 0 || (file = oracle_open_trace ()) == 0)
+    return;
+  fputs ("{\"stage\": \"global_start\", \"fixed\": ", file);
+  oracle_print_hard_regs (file, fixed_reg_set);
+  fputs (", \"call_used\": ", file);
+  oracle_print_hard_regs (file, call_used_reg_set);
+  fputs (", \"call_fixed\": ", file);
+  oracle_print_hard_regs (file, call_fixed_reg_set);
+  fputs (", \"no_global\": ", file);
+  oracle_print_hard_regs (file, no_global_alloc_regs);
+  fputs (", \"used_so_far\": ", file);
+  oracle_print_hard_regs (file, regs_used_so_far);
+  fputs (", \"alike\": [", file);
+  for (i = 0; i < FIRST_PSEUDO_REGISTER; i++)
+    {
+      CLEAR_HARD_REG_SET (set);
+      for (j = 0; j < FIRST_PSEUDO_REGISTER; j++)
+	if (REGNO_REG_CLASS (i) == REGNO_REG_CLASS (j)
+	    || reg_class_subset_p (REGNO_REG_CLASS (i), REGNO_REG_CLASS (j))
+	    || reg_class_subset_p (REGNO_REG_CLASS (j), REGNO_REG_CLASS (i)))
+	  SET_HARD_REG_BIT (set, j);
+      fputs (i == 0 ? "" : ", ", file);
+      oracle_print_hard_regs (file, set);
+    }
+  fputs ("], \"local_n_refs\": [", file);
+  for (i = 0; i < FIRST_PSEUDO_REGISTER; i++)
+    oracle_put_item (file, i == 0 ? "" : ", ", local_reg_n_refs[i]);
+  fputs ("], \"local_live_length\": [", file);
+  for (i = 0; i < FIRST_PSEUDO_REGISTER; i++)
+    oracle_put_item (file, i == 0 ? "" : ", ", local_reg_live_length[i]);
+  fputs ("], \"allocnos\": [", file);
+  for (allocno = 0; allocno < max_allocno; allocno++)
+    {
+      mode = PSEUDO_REGNO_MODE (allocno_reg[allocno]);
+      oracle_print_allocno (file, allocno == 0 ? "" : ", ", allocno);
+      oracle_put_item (file, ", \"left_out\": ",
+		       reg_live_length[allocno_reg[allocno]] < 0);
+      oracle_put_item (file, ", \"gpr_nregs\": ",
+		       HARD_REGNO_NREGS (GP_REG_FIRST, mode));
+      oracle_put_item (file, ", \"fpr_nregs\": ",
+		       HARD_REGNO_NREGS (FP_REG_FIRST, mode));
+      fputs (", \"conflicts\": [", file);
+      separator = "";
+      for (i = 0; i < max_allocno; i++)
+	if (CONFLICTP (allocno, i))
+	  {
+	    oracle_put_item (file, separator, i);
+	    separator = ", ";
+	  }
+      fputs ("], \"mode_ok\": ", file);
+      CLEAR_HARD_REG_SET (set);
+      for (i = 0; i < FIRST_PSEUDO_REGISTER; i++)
+	if (HARD_REGNO_MODE_OK (i, mode))
+	  SET_HARD_REG_BIT (set, i);
+      oracle_print_hard_regs (file, set);
+      fputs (", \"preferred_class\": ", file);
+      class = reg_preferred_class (allocno_reg[allocno]);
+      oracle_print_hard_regs (file, reg_class_contents[(int) class]);
+      fputs (", \"alternate_class\": ", file);
+      class = reg_alternate_class (allocno_reg[allocno]);
+      CLEAR_HARD_REG_SET (set);
+      if (class != NO_REGS)
+	COPY_HARD_REG_SET (set, reg_class_contents[(int) class]);
+      oracle_print_hard_regs (file, set);
+      fputs (", \"hard_conflicts\": ", file);
+      oracle_print_hard_regs (file, hard_reg_conflicts[allocno]);
+      fputs (", \"full_preferences\": ", file);
+      oracle_print_hard_regs (file, hard_reg_full_preferences[allocno]);
+      fputs (", \"copy_preferences\": ", file);
+      oracle_print_hard_regs (file, hard_reg_copy_preferences[allocno]);
+      fputs (", \"preferences\": ", file);
+      oracle_print_hard_regs (file, hard_reg_preferences[allocno]);
+      fputs ("}", file);
+    }
+  fputs ("]}\n", file);
+  oracle_end_record (file);
+}
