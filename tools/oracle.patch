+/* Record for the oracle's trace (see oracle_open_trace in reload1.c) each
+   allocno, in the order they were placed in.  */
+
+static void
+oracle_trace_global ()
+{
+  FILE *file;
+  int i, allocno, other;
+  char *separator;
+
+  if (max_allocno == 0 || (file = oracle_open_trace ()) == 0)
+    return;
+  fputs ("{\"stage\": \"global\", \"allocnos\": [", file);
+  for (i = 0; i < max_allocno; i++)
+    {
+      allocno = allocno_order[i];
