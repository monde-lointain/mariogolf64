{
    "snowboardkids2-decomp": {
        "driver_dir": "tools/gcc_kmc",
        "language": "-nostdinc -w -fno-asm -I{src_dir} -I include -I lib/ultralib/include -I lib/ultralib/include/PR -I lib/libmus/include/PR -I lib/libmus/src -I lib/f3dex2/PR -D_LANGUAGE_C -D_MIPS_SZLONG=32 -D_MIPS_SZINT=32 -D__USE_ISOC99 -DF3DEX_GBI_2 -DNDEBUG -D_FINALROM -I {dir} -I src/ -I assets/courses -I assets/modelpayload -I build/include -I build/{dir}",
        "codegen": "-mabi=32 -mgp32 -mfp32 -mno-abicalls -fno-PIC -G 0 -Wa,-force-n64align -funsigned-char -mips3 -EB -fno-builtin -fno-common -O2",
        "objects": "build/{stem}.o",
        "filter": "python3 tools/textconv.py tools/charmap.txt {src} -"
    },
    "marioparty3": {
        "driver_dir": "tools/gcc_2.7.2/linux",
        "language": "-I{src_dir} -D_LANGUAGE_C -DOLD_GCC -I include -I build/include -I src -DF3DEX_GBI_2",
        "codegen": "-O1 -G0 -mips3 -mgp32 -mfp32 -Wa,--force-n64align",
        "objects": "build/{stem}.c.o"
    },
    "marioparty": {
        "driver_dir": "tools/gcc_2.7.2/linux",
        "language": "-D_LANGUAGE_C -I include -I build/include -I src -DF3DEX_GBI_2",
        "codegen": "-O1 -G0 -mips3 -mgp32 -mfp32 -Wa,--vr4300mul-off",
        "objects": "build/{stem}.c.o"
    },
    "drmario64": {
        "driver_dir": "tools/gcc_kmc/linux/2.7.2",
        "language": "-nostdinc -w -DVERSION_US=1 -DSCOMMON_IN_COMMON=1 -DBUILD_VERSION=8 -Ilib/ultralib/include -Ilib/ultralib/include/PR -Ilib/libmus/include -Ilib/ultralib/include/gcc -Iinclude -Ibin/us -Ibuild/us/bin/us -I build/us -I. -D_MIPS_SZLONG=32 -D__USE_ISOC99 -D __IS_KMC__=1 -DNDEBUG -D_FINALROM -DF3DEX_GBI_2 -D_LANGUAGE_C -I {src_dir}/ -I build/us/{src_dir}/",
        "codegen": "-mabi=32 -mgp32 -mfp32 -fno-PIC -G 0 -mno-abicalls -Wa,--force-n64align -funsigned-char -mips3 -EB -O2",
        "objects": "build/us/{stem}.o",
        "filter": "iconv --from-code=UTF-8 --to-code=Shift-JIS//TRANSLIT {src}"
    },
    "puzzleleague64": {
        "driver_dir": "tools/gcc_kmc/linux/2.7.2",
        "language": "-nostdinc -w -DVERSION_USA=1 -DVERSION_STR=\"usa\" -I lib/ultralib/include -I lib/ultralib/include/PR -I lib/ultralib/include/compiler/gcc -I lib/libhvqm/include -I include -I bin/usa -I build/usa/bin/usa -I . -D_MIPS_SZLONG=32 -D__USE_ISOC99 -DF3DEX_GBI -D_LANGUAGE_C -I {src_dir}/ -I build/usa/{src_dir}/",
        "codegen": "-fno-PIC -G 0 -mgp32 -mfp32 -Wa,--force-n64align -fsigned-char -mips3 -EB -O2 -g",
        "objects": "build/usa/{stem}.o",
        "fix": "tools/rstools/target/release/fix_relocs {obj}"
    }
}
