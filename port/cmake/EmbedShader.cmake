# Writes a shader's SPIR-V and MSL as C arrays, for the renderer to hand to
# SDL_GPU. The MSL array ends in a zero, as SDL_GPU reads it as a string.
#
# Run as a script:
#   cmake -DSPIRV=<a.spv> -DMSL=<a.msl> -DNAME=<identifier> -DOUTPUT=<a.h>
#         -P EmbedShader.cmake

cmake_minimum_required(VERSION 3.30)

foreach(variable IN ITEMS SPIRV MSL NAME OUTPUT)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "EmbedShader.cmake needs ${variable}")
    endif()
endforeach()

# The file's bytes as a C initializer's body, sixteen to a line. CMake's
# regular expressions have no counted repeats, so the lines are cut by hand.
function(format_bytes file terminator result)
    file(READ "${file}" hex HEX)
    string(APPEND hex "${terminator}")
    string(LENGTH "${hex}" length)
    set(lines "")
    set(offset 0)
    while(offset LESS length)
        string(SUBSTRING "${hex}" ${offset} 32 chunk)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " chunk "${chunk}")
        string(STRIP "${chunk}" chunk)
        list(APPEND lines "    ${chunk}")
        math(EXPR offset "${offset} + 32")
    endwhile()
    list(JOIN lines "\n" bytes)
    set(${result} "${bytes}" PARENT_SCOPE)
endfunction()

format_bytes("${SPIRV}" "" spirv_bytes)
format_bytes("${MSL}" "00" msl_bytes)

cmake_path(GET SPIRV FILENAME spirv_name)
file(WRITE "${OUTPUT}.tmp" "/* Generated by EmbedShader.cmake from ${spirv_name} */

static const unsigned char ${NAME}_spirv[] = {
${spirv_bytes}
};

static const unsigned char ${NAME}_msl[] = {
${msl_bytes}
};
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
