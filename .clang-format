BasedOnStyle: Google
# The headers rely on common.h's types, so it always comes first.
# The rest are Google's own categories.
IncludeCategories:
  - Regex: '^"common\.h"$'
    Priority: -1
  - Regex: '^<ext/.*\.h>'
    Priority: 2
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<.*'
    Priority: 2
  - Regex: '.*'
    Priority: 3
# splat reads the function or symbol name from each INCLUDE_ASM and
# INCLUDE_RODATA call, and doesn't expect it on a line of its own
WhitespaceSensitiveMacros: [INCLUDE_ASM, INCLUDE_RODATA]
# Code Complete's style 2: every if and loop body is a braced block on lines
# of its own, so a statement added to it can't fall outside the block
InsertBraces: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortEnumsOnASingleLine: false
# Code Complete's chapter 31 indents continuation lines a standard amount
# rather than aligning them under an open bracket or the first operand, so
# renaming a routine doesn't move every line of its argument list
AlignAfterOpenBracket: false
AlignOperands: DontAlign
