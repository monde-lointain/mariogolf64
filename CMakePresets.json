{
  "version": 9,
  "cmakeMinimumRequired": {"major": 3, "minor": 30, "patch": 0},
  "configurePresets": [
    {"name": "us", "displayName": "US retail ROM", "generator": "Ninja", "binaryDir": "${sourceDir}/build/us", "cacheVariables": {"BUILD_TESTING": true, "MG64_NONMATCHING": false}},
    {"name": "nonmatching", "displayName": "Isolated nonmatching C", "inherits": "us", "binaryDir": "${sourceDir}/build/nonmatching", "cacheVariables": {"MG64_NONMATCHING": true}}
  ],
  "buildPresets": [
    {"name": "us", "configurePreset": "us", "targets": ["rom"]},
    {"name": "nonmatching", "configurePreset": "nonmatching", "targets": ["rom"]},
    {"name": "tools", "configurePreset": "us", "targets": ["tools"]},
    {"name": "extract", "configurePreset": "us", "targets": ["extract"]}
  ],
  "testPresets": [
    {"name": "rom", "configurePreset": "us", "filter": {"include": {"label": "rom"}}, "output": {"outputOnFailure": true}},
    {"name": "tooling", "configurePreset": "us", "filter": {"include": {"label": "tooling"}}, "output": {"outputOnFailure": true}}
  ],
  "workflowPresets": [
    {"name": "verify", "steps": [{"type": "configure", "name": "us"}, {"type": "build", "name": "us"}, {"type": "test", "name": "rom"}]}
  ]
}
