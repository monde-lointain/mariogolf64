{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 30,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "pc",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/pc/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux, with the default C compiler",
            "inherits": "pc",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux, with Clang",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "linux-sanitize",
            "displayName": "Linux, with AddressSanitizer and UndefinedBehaviorSanitizer",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MG64_SANITIZERS": "address;undefined;pointer-compare;pointer-subtract"
            }
        },
        {
            "name": "linux-clang-sanitize",
            "displayName": "Linux, a Clang debug build with AddressSanitizer and UBSan, without KMC GCC's meanings, and libFuzzer",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MG64_SANITIZERS": "address;undefined",
                "MG64_KMC_SEMANTICS": "OFF",
                "MG64_FUZZ": "ON"
            }
        },
        {
            "name": "linux-clang-tysan",
            "displayName": "Linux, an optimized Clang build with TypeSanitizer, without KMC GCC's meanings",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-23",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "MG64_SANITIZERS": "type",
                "MG64_KMC_SEMANTICS": "OFF"
            }
        },
        {
            "name": "linux-clang-tsan",
            "displayName": "Linux, an optimized Clang build with ThreadSanitizer",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "MG64_SANITIZERS": "thread"
            }
        },
        {
            "name": "windows-mingw",
            "displayName": "64-bit Windows, cross-compiled with MinGW-w64",
            "inherits": "pc",
            "toolchainFile": "${sourceDir}/port/cmake/toolchains/mingw-w64-x86_64.cmake"
        },
        {
            "name": "macos",
            "displayName": "macOS, with Apple's Clang",
            "inherits": "pc",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-sanitize",
            "displayName": "macOS, an Apple Clang debug build with AddressSanitizer and UBSan, without KMC GCC's meanings",
            "inherits": "macos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MG64_SANITIZERS": "address;undefined",
                "MG64_KMC_SEMANTICS": "OFF"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "64-bit Arm Android, cross-compiled with the NDK",
            "inherits": "pc",
            "toolchainFile": "$env{ANDROID_HOME}/ndk/30.0.16248370/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-29",
                "ANDROID_STL": "c++_static",
                "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON",
                "BUILD_TESTING": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux",
            "configurePreset": "linux"
        },
        {
            "name": "linux-clang",
            "configurePreset": "linux-clang"
        },
        {
            "name": "linux-sanitize",
            "configurePreset": "linux-sanitize"
        },
        {
            "name": "linux-clang-sanitize",
            "configurePreset": "linux-clang-sanitize"
        },
        {
            "name": "linux-clang-tysan",
            "configurePreset": "linux-clang-tysan"
        },
        {
            "name": "linux-clang-tsan",
            "configurePreset": "linux-clang-tsan"
        },
        {
            "name": "windows-mingw",
            "configurePreset": "windows-mingw"
        },
        {
            "name": "macos",
            "configurePreset": "macos"
        },
        {
            "name": "macos-sanitize",
            "configurePreset": "macos-sanitize"
        },
        {
            "name": "android-arm64",
            "configurePreset": "android-arm64",
            "targets": ["all", "mg64_apk"]
        }
    ],
    "testPresets": [
        {
            "name": "pc",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "linux",
            "inherits": "pc",
            "configurePreset": "linux"
        },
        {
            "name": "linux-clang",
            "inherits": "pc",
            "configurePreset": "linux-clang"
        },
        {
            "name": "linux-sanitize",
            "inherits": "pc",
            "configurePreset": "linux-sanitize",
            "environment": {
                "ASAN_OPTIONS": "detect_invalid_pointer_pairs=1:detect_stack_use_after_return=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        },
        {
            "name": "linux-clang-sanitize",
            "inherits": "pc",
            "configurePreset": "linux-clang-sanitize",
            "environment": {
                "ASAN_OPTIONS": "detect_stack_use_after_return=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        },
        {
            "name": "linux-clang-tysan",
            "inherits": "pc",
            "configurePreset": "linux-clang-tysan",
            "environment": {
                "TYSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        },
        {
            "name": "linux-clang-tsan",
            "inherits": "pc",
            "configurePreset": "linux-clang-tsan",
            "environment": {
                "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:suppressions=${sourceDir}/port/src/sanitizers/tsan_suppressions.txt",
                "VK_LOADER_DRIVERS_SELECT": "*lvp*"
            }
        },
        {
            "name": "windows-mingw",
            "inherits": "pc",
            "configurePreset": "windows-mingw",
            "environment": {
                "WINEDEBUG": "-all"
            }
        },
        {
            "name": "macos",
            "inherits": "pc",
            "configurePreset": "macos"
        },
        {
            "name": "macos-sanitize",
            "inherits": "pc",
            "configurePreset": "macos-sanitize",
            "environment": {
                "ASAN_OPTIONS": "detect_stack_use_after_return=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "linux",
            "steps": [
                {"type": "configure", "name": "linux"},
                {"type": "build", "name": "linux"},
                {"type": "test", "name": "linux"}
            ]
        },
        {
            "name": "linux-clang",
            "steps": [
                {"type": "configure", "name": "linux-clang"},
                {"type": "build", "name": "linux-clang"},
                {"type": "test", "name": "linux-clang"}
            ]
        },
        {
            "name": "linux-sanitize",
            "steps": [
                {"type": "configure", "name": "linux-sanitize"},
                {"type": "build", "name": "linux-sanitize"},
                {"type": "test", "name": "linux-sanitize"}
            ]
        },
        {
            "name": "linux-clang-sanitize",
            "steps": [
                {"type": "configure", "name": "linux-clang-sanitize"},
                {"type": "build", "name": "linux-clang-sanitize"},
                {"type": "test", "name": "linux-clang-sanitize"}
            ]
        },
        {
            "name": "linux-clang-tysan",
            "steps": [
                {"type": "configure", "name": "linux-clang-tysan"},
                {"type": "build", "name": "linux-clang-tysan"},
                {"type": "test", "name": "linux-clang-tysan"}
            ]
        },
        {
            "name": "linux-clang-tsan",
            "steps": [
                {"type": "configure", "name": "linux-clang-tsan"},
                {"type": "build", "name": "linux-clang-tsan"},
                {"type": "test", "name": "linux-clang-tsan"}
            ]
        },
        {
            "name": "windows-mingw",
            "steps": [
                {"type": "configure", "name": "windows-mingw"},
                {"type": "build", "name": "windows-mingw"},
                {"type": "test", "name": "windows-mingw"}
            ]
        },
        {
            "name": "macos",
            "steps": [
                {"type": "configure", "name": "macos"},
                {"type": "build", "name": "macos"},
                {"type": "test", "name": "macos"}
            ]
        },
        {
            "name": "macos-sanitize",
            "steps": [
                {"type": "configure", "name": "macos-sanitize"},
                {"type": "build", "name": "macos-sanitize"},
                {"type": "test", "name": "macos-sanitize"}
            ]
        }
    ]
}
